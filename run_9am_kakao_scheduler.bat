@echo off
chcp 65001 > nul
cd /d "%~dp0"

echo =================================================================
echo  갓성호님의 매일 아침 9시 카카오톡 바닥반등 종목 자동 알림 스케줄러
echo =================================================================
echo.
echo  매일 아침 09:00 정각에 주식 시장을 자동으로 스캔하여
echo  포착된 바닥 반등 종목을 내 카카오톡으로 자동 전송합니다.
echo.
echo  1. 즉시 테스트 실행 (지금 바로 카카오톡 전송 테스트)
echo  2. 매일 아침 9:00 자동 알림 대기 시작
echo.

set /p choice="원하시는 번호를 입력하세요 (1 또는 2): "

if "%choice%"=="1" (
    echo.
    echo 즉시 테스트 스캔 및 카카오톡 알림 발송 중...
    python schedule_kakao_9am.py --now
) else (
    echo.
    echo 매일 아침 9:00 자동 알림 대기를 시작합니다...
    python schedule_kakao_9am.py
)

pause
